# ── Supabase (WAJIB — tanpa ini aplikasi GAGAL, tidak ada fallback hardcode) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-publishable>

# Service Role Key (RAHASIA — server-only, jangan pernah bocor ke client)
# Dipakai createAdminClient() untuk API admin (bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
